# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/planforge

# === Backend ===
PORT=4000
CORS_ORIGIN=http://localhost:3000

# === JWT ===
JWT_ACCESS_SECRET=planforge-access-secret-change-me
JWT_REFRESH_SECRET=planforge-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === Redis ===
# Local Docker Redis:
REDIS_HOST=localhost
REDIS_PORT=6379
# Cloud Redis / Upstash (overrides REDIS_HOST/PORT if set):
# REDIS_URL="rediss://default:your-token@your-host.upstash.io:6379"

# === MinIO / S3 ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=planforge-uploads
S3_REGION=us-east-1

# === Email / SMTP Configuration ===
# For local dev with Mailpit (docker-compose):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# For real delivery (Brevo / SendGrid / etc.):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@domain.com
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="PlanForge <your_verified_sender@domain.com>"
APP_URL=http://localhost:3000
